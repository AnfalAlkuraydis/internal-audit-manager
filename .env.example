# LIVE is the only implemented mode. No demo adapter exists.
LLM_MODE=live
# Full HTTPS chat-completions URL copied from your Azure deployment.
# Example format: https://RESOURCE.services.ai.azure.com/openai/v1/chat/completions
AZURE_GROK_CHAT_URL=
AZURE_GROK_DEPLOYMENT=
AZURE_GROK_API_KEY=
LLM_TIMEOUT_SECONDS=30
# This file is a template. Never add real credentials here.

# Optional local database path used by scripts.prepare_data (not Azure credentials).
AUDIT_DATABASE_PATH=var/audit.sqlite

# Optional protected local-demo API. Choose distinct private tokens locally.
# Empty values grant no access; never commit real tokens.
AUDIT_AUDITOR_TOKEN=
AUDIT_REVIEWER_TOKEN=

# Phase 4: LIVE inference, simulated mail, durable local checkpoints.
EMAIL_MODE=simulated
AUDIT_CHECKPOINT_PATH=var/checkpoints.sqlite
# The automatic worker runs while the backend server is running.
AUDIT_WORKER_ENABLED=1
